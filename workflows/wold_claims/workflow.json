{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "wold-claims",
  "product": "wold_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/b92729110e93f3bccb23b9947bae405a9829ecd2674d917e74b1bce519d6d9ef/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/58b28305f7f2150396f405a0c1339cd0c6477c40aa5ab6c7c5587d64443e2053/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "cldf_languages_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/languages.csv",
    "cldf_forms_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/forms.csv",
    "cldf_parameters_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/parameters.csv",
    "cldf_borrowings_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/borrowings.csv",
    "cldf_contributions_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/contributions.csv",
    "cldf_contributors_csv": "data/workspaces/etymology/sources/wold/raw/lexibank-wold-1df62b9/cldf/contributors.csv",
    "wold_donors_json": "data/workspaces/etymology/sources/wold/etc/donors.json",
    "wold_judgements_jsonl": "data/workspaces/etymology/sources/wold/etc/judgements.jsonl",
    "wold_kinds_json": "data/workspaces/etymology/sources/wold/etc/kinds.json",
    "wold_languages_json": "data/workspaces/etymology/sources/wold/etc/languages.json",
    "wold_source_json": "data/workspaces/etymology/sources/wold/etc/source.json"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.wold",
      "--out",
      "{output}/wold.jsonl",
      "--counts",
      "{output}/wold_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_words",
      "scan",
      "--source",
      "wold",
      "--assertions",
      "{output}/wold.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_words",
      "run",
      "--source",
      "wold",
      "--assertions",
      "{output}/wold.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/wold.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "wold.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
