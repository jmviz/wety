{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "cariban-claims",
  "product": "cariban_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/4daa3b3b2aca9faeee3930cb2ab2e88c8ee751c4846194df65a707410f21f34f/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/58b28305f7f2150396f405a0c1339cd0c6477c40aa5ab6c7c5587d64443e2053/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "families": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/families.json",
    "cldf_cariban_sql_gz": "data/workspaces/etymology/sources/cariban/raw/cariban.sql.gz",
    "cariban_judgements_jsonl": "data/workspaces/etymology/sources/cariban/etc/judgements.jsonl",
    "cariban_kinds_json": "data/workspaces/etymology/sources/cariban/etc/kinds.json",
    "cariban_languages_json": "data/workspaces/etymology/sources/cariban/etc/languages.json",
    "cariban_orthography_attested_tsv": "data/workspaces/etymology/sources/cariban/etc/orthography-attested.tsv",
    "cariban_orthography_tsv": "data/workspaces/etymology/sources/cariban/etc/orthography.tsv",
    "cariban_source_json": "data/workspaces/etymology/sources/cariban/etc/source.json",
    "wiktionary_orthography_map": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map.tsv",
    "wiktionary_orthography_map_attested": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map-attested.tsv"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.cariban",
      "--out",
      "{output}/cariban.jsonl",
      "--counts",
      "{output}/cariban_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "scan",
      "--source",
      "cariban",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--families",
      "{input_families}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "run",
      "--source",
      "cariban",
      "--assertions",
      "{output}/cariban.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/cariban.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "cariban.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
