{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "iecor-claims",
  "product": "iecor_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/27e274bf3283b0c8a0f62b7b8faae2d2771e778f8979e5c435489f34e4f27076/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/e598976b43baed1d3e7fe3bd377acd5311d8820788aa7800f7be6554c81c5d82/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "cldf_languages_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/languages.csv",
    "cldf_forms_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/forms.csv",
    "cldf_parameters_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/parameters.csv",
    "cldf_cognatesets_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/cognatesets.csv",
    "cldf_cognates_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/cognates.csv",
    "cldf_loans_csv": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/loans.csv",
    "cldf_sources_bib": "data/workspaces/etymology/sources/iecor/raw/lexibank-iecor-dd1ebc9/cldf/sources.bib",
    "iecor_judgements_jsonl": "data/workspaces/etymology/sources/iecor/etc/judgements.jsonl",
    "iecor_kinds_json": "data/workspaces/etymology/sources/iecor/etc/kinds.json",
    "iecor_languages_json": "data/workspaces/etymology/sources/iecor/etc/languages.json",
    "iecor_orthography_tsv": "data/workspaces/etymology/sources/iecor/etc/orthography.tsv",
    "iecor_roots_json": "data/workspaces/etymology/sources/iecor/etc/roots.json",
    "iecor_source_json": "data/workspaces/etymology/sources/iecor/etc/source.json",
    "wiktionary_orthography_ine_itc": "data/workspaces/etymology/sources/wiktionary/etc/orthography-ine-itc.tsv"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.iecor",
      "--out",
      "{output}/iecor.jsonl",
      "--counts",
      "{output}/iecor_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_words",
      "scan",
      "--source",
      "iecor",
      "--assertions",
      "{output}/iecor.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_words",
      "run",
      "--source",
      "iecor",
      "--assertions",
      "{output}/iecor.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/iecor.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "iecor.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
