{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "acd-claims",
  "product": "acd_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/27e274bf3283b0c8a0f62b7b8faae2d2771e778f8979e5c435489f34e4f27076/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/e598976b43baed1d3e7fe3bd377acd5311d8820788aa7800f7be6554c81c5d82/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "families": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/families.json",
    "cldf_languages_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/languages.csv",
    "cldf_media_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/media.csv",
    "cldf_forms_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/forms.csv",
    "cldf_cognatesets_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/cognatesets.csv",
    "cldf_cognates_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/cognates.csv",
    "cldf_cf_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/cf.csv",
    "cldf_cfitems_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/cfitems.csv",
    "cldf_borrowings_csv": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/borrowings.csv",
    "cldf_sources_bib": "data/workspaces/etymology/sources/acd/raw/lexibank-acd-16085f2/cldf/sources.bib",
    "acd_languages": "data/workspaces/etymology/sources/acd/etc/languages.json",
    "acd_kinds": "data/workspaces/etymology/sources/acd/etc/kinds.json",
    "acd_source": "data/workspaces/etymology/sources/acd/etc/source.json",
    "acd_orthography": "data/workspaces/etymology/sources/acd/etc/orthography.tsv",
    "acd_orthography_attested": "data/workspaces/etymology/sources/acd/etc/orthography-attested.tsv",
    "acd_judgements": "data/workspaces/etymology/sources/acd/etc/judgements.jsonl",
    "wiktionary_orthography_map": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map.tsv",
    "wiktionary_orthography_map_attested": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map-attested.tsv"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.acd",
      "--out",
      "{output}/acd.jsonl",
      "--counts",
      "{output}/acd_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "scan",
      "--source",
      "acd",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--families",
      "{input_families}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "run",
      "--source",
      "acd",
      "--assertions",
      "{output}/acd.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/acd.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "acd.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
