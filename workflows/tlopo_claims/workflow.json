{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "tlopo-claims",
  "product": "tlopo_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/27e274bf3283b0c8a0f62b7b8faae2d2771e778f8979e5c435489f34e4f27076/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/5e26d98008b10ce01fa50ce97075384b719549cd0f3f8c8956c5d7b977224c85/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "families": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/families.json",
    "cldf_languages_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/languages.csv",
    "cldf_media_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/media.csv",
    "cldf_tree_nwk": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/tree.nwk",
    "cldf_forms_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/forms.csv",
    "cldf_cognatesets_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/cognatesets.csv",
    "cldf_cognates_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/cognates.csv",
    "cldf_cf_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/cf.csv",
    "cldf_cfitems_csv": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/cfitems.csv",
    "cldf_sources_bib": "data/workspaces/etymology/sources/tlopo/raw/tlopo-0.1.1/cldf/sources.bib",
    "tlopo_judgements_jsonl": "data/workspaces/etymology/sources/tlopo/etc/judgements.jsonl",
    "tlopo_kinds_json": "data/workspaces/etymology/sources/tlopo/etc/kinds.json",
    "tlopo_languages_json": "data/workspaces/etymology/sources/tlopo/etc/languages.json",
    "tlopo_orthography_attested_tsv": "data/workspaces/etymology/sources/tlopo/etc/orthography-attested.tsv",
    "tlopo_orthography_tsv": "data/workspaces/etymology/sources/tlopo/etc/orthography.tsv",
    "tlopo_source_json": "data/workspaces/etymology/sources/tlopo/etc/source.json",
    "tlopo_tree_json": "data/workspaces/etymology/sources/tlopo/etc/tree.json",
    "wiktionary_orthography_map": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map.tsv",
    "wiktionary_orthography_map_attested": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map-attested.tsv"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.tlopo",
      "--out",
      "{output}/tlopo.jsonl",
      "--counts",
      "{output}/tlopo_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "scan",
      "--source",
      "tlopo",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--families",
      "{input_families}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "run",
      "--source",
      "tlopo",
      "--assertions",
      "{output}/tlopo.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/tlopo.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "tlopo.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
