{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "graph-smoke",
  "inputs": {
    "entries": "workflows/etymology_graph/fixtures/minimal.jsonl",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "pos": "crates/core/src/pos_phf.rs",
    "model": "data/registry/embedding-model.json"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "workflow_tools.model"
    ],
    [
      "cargo",
      "run",
      "--locked",
      "-p",
      "processor",
      "--bin",
      "processor",
      "--",
      "--entries",
      "{input_entries}",
      "--serialization-path",
      "{output}/wety.bin.gz",
      "--embeddings-model",
      "ibm-granite/granite-embedding-small-english-r2",
      "--embeddings-model-revision",
      "2ab6fa8ea2d674564defd37171ae19079b864b33",
      "--embeddings-cache-path",
      "{repo}/data/cache/embeddings/current"
    ]
  ],
  "validation": [
    [
      "cargo",
      "run",
      "--locked",
      "-p",
      "wety-core",
      "--example",
      "validate_graph",
      "--",
      "{output}/wety.bin.gz"
    ]
  ],
  "required_outputs": [
    "wety.bin.gz"
  ],
  "entrypoint": "wety.bin.gz"
}
