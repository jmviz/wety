{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "etymology-graph",
  "product": "etymology_graph",
  "inputs": {
    "wiktextract": "data/artifacts/wiktextract/6da0ba5bf330650cba59911466da388d3f60c69519a50dc9ca71451b0bfba506/files/raw-wiktextract-data.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/2d98b7aa0c9965e1492db2e242ead832fe7e3c161e1f1a27c1d177135c6df2b7/files/languages.json",
    "pos": "crates/core/src/pos_phf.rs",
    "model": "data/registry/embedding-model.json"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "workflow_tools.model"
    ],
    [
      "cargo",
      "run",
      "--locked",
      "--release",
      "-p",
      "processor",
      "--bin",
      "processor",
      "--",
      "--wiktextract-path",
      "{input_wiktextract}",
      "--serialization-path",
      "{output}/wety.json.gz",
      "--embeddings-model-revision",
      "7b92c94edb86f18b2d52ed2797de0c5d474632ae",
      "--embeddings-cache-path",
      "{repo}/data/cache/embeddings/current"
    ]
  ],
  "validation": [
    [
      "cargo",
      "run",
      "--locked",
      "--release",
      "-p",
      "wety-core",
      "--example",
      "validate_graph",
      "--",
      "{output}/wety.json.gz"
    ]
  ],
  "required_outputs": [
    "wety.json.gz"
  ],
  "entrypoint": "wety.json.gz"
}
