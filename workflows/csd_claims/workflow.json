{
  "schema_version": 1,
  "mode": "artifact",
  "collection": "csd-claims",
  "product": "csd_claims",
  "inputs": {
    "export": "data/artifacts/etymology-assertions/b92729110e93f3bccb23b9947bae405a9829ecd2674d917e74b1bce519d6d9ef/files/assertions.jsonl.gz",
    "entries": "data/artifacts/wiktionary-entries/5e26d98008b10ce01fa50ce97075384b719549cd0f3f8c8956c5d7b977224c85/files/entries.jsonl.gz",
    "languages": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/languages.json",
    "families": "data/artifacts/wiktionary-export/57d16abeffbce475ff189e0734fd8937eab8d7417b1ee08273e746b43b350cb0/files/families.json",
    "cldf_csd_sql_gz": "data/workspaces/etymology/sources/csd/raw/csd.sql.gz",
    "csd_judgements_jsonl": "data/workspaces/etymology/sources/csd/etc/judgements.jsonl",
    "csd_kinds_json": "data/workspaces/etymology/sources/csd/etc/kinds.json",
    "csd_languages_json": "data/workspaces/etymology/sources/csd/etc/languages.json",
    "csd_orthography_attested_tsv": "data/workspaces/etymology/sources/csd/etc/orthography-attested.tsv",
    "csd_orthography_tsv": "data/workspaces/etymology/sources/csd/etc/orthography.tsv",
    "csd_source_json": "data/workspaces/etymology/sources/csd/etc/source.json",
    "wiktionary_orthography_map": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map.tsv",
    "wiktionary_orthography_map_attested": "data/workspaces/etymology/sources/wiktionary/etc/orthography-map-attested.tsv"
  },
  "commands": [
    [
      "{python}",
      "-m",
      "etymology.convert.csd",
      "--out",
      "{output}/csd.jsonl",
      "--counts",
      "{output}/csd_counts.json"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "scan",
      "--source",
      "csd",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--languages",
      "{input_languages}",
      "--families",
      "{input_families}",
      "--work",
      "{output}/work"
    ],
    [
      "{python}",
      "-m",
      "etymology.match_etymdict",
      "run",
      "--source",
      "csd",
      "--assertions",
      "{output}/csd.jsonl",
      "--export",
      "{input_export}",
      "--entries",
      "{input_entries}",
      "--work",
      "{output}/work",
      "--out",
      "{output}/matches"
    ]
  ],
  "validation": [
    [
      "{python}",
      "-m",
      "etymology.assertions",
      "{output}/csd.jsonl",
      "{output}/matches/assertions.jsonl"
    ]
  ],
  "required_outputs": [
    "csd.jsonl",
    "matches/assertions.jsonl"
  ],
  "entrypoint": "matches/assertions.jsonl"
}
