{
  "schema_version": 2,
  "default_backend": "openrouter",
  "backends": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "headers": {
        "HTTP-Referer": "https://github.com/jmviz/wety",
        "X-Title": "wety language dating"
      },
      "defaults": {
        "provider": {
          "zdr": true,
          "require_parameters": true,
          "allow_fallbacks": true,
          "sort": "price",
          "quantizations": [
            "fp8",
            "bf16",
            "fp16",
            "unknown"
          ],
          "data_collection": "deny"
        },
        "usage": {
          "include": true
        },
        "session_id_from": "family",
        "retries": {
          "max": 5,
          "backoff_seconds": 5,
          "retry_on": [
            408,
            409,
            425,
            429,
            500,
            502,
            503,
            504
          ]
        },
        "plugins": [
          {
            "id": "response-healing"
          }
        ]
      }
    },
    "anthropic": {},
    "claude-agent": {
      "on_usage_limit": "wait",
      "max_wait_seconds": 21600,
      "max_attempts": 6,
      "fallback_backend": "openrouter",
      "why": "the Claude Agent SDK runs on a Claude subscription with 5-hour/weekly usage windows; on a `rejected` rate-limit event or a 429 result the backend waits until resets_at (capped) and retries \u2014 every stage writes progress as it goes, so an interrupted run resumes where it stopped. Set on_usage_limit to `fallback` to continue on OpenRouter (paid) instead, or `fail` to stop."
    },
    "codex": {
      "executable": "codex",
      "auth_credentials_store": "file",
      "timeout_seconds": 600,
      "why": "Opt-in ChatGPT subscription backend via codex exec. Run codex login first; API-key logins are rejected, environment API keys are excluded, and errors/usage limits fail without paid fallback. Role assignments are provisional and not dating-quality validated. Set auth_credentials_store to keyring or auto if that is where your Codex login is stored."
    }
  },
  "roles": {
    "screen": {
      "backend": "openrouter",
      "validation_status": "provisional; dating role-specific accuracy not measured",
      "backends": {
        "openrouter": {
          "model": "z-ai/glm-5.3-flash",
          "fallbacks": [
            "openai/gpt-5.6-luna",
            "deepseek/deepseek-v4.1-flash"
          ],
          "batch_model": "z-ai/glm-5.3-flash:batch",
          "reasoning": {
            "effort": "low"
          },
          "max_tokens": 1024
        },
        "anthropic": {
          "model": "claude-haiku-4-5",
          "effort": null,
          "max_tokens": 1024
        },
        "claude-agent": {
          "model": "claude-haiku-4-5",
          "effort": null,
          "max_tokens": 1024
        },
        "codex": {
          "model": "gpt-5.6-terra",
          "effort": "low"
        }
      }
    },
    "extract": {
      "backend": "openrouter",
      "validation_status": "provisional; dating role-specific accuracy not measured",
      "backends": {
        "openrouter": {
          "model": "google/gemini-3.8-flash",
          "fallbacks": [
            "openai/gpt-5.6-sol",
            "z-ai/glm-5.3"
          ],
          "batch_model": "google/gemini-3.8-flash:batch",
          "reasoning": {
            "effort": "medium"
          },
          "max_tokens": 32000,
          "cache_system_prompt": true
        },
        "anthropic": {
          "model": "claude-sonnet-5",
          "effort": "medium",
          "max_tokens": 32000
        },
        "claude-agent": {
          "model": "claude-sonnet-5",
          "effort": "medium",
          "max_tokens": 32000
        },
        "codex": {
          "model": "gpt-5.6-terra",
          "effort": "medium"
        }
      }
    },
    "synthesize": {
      "backend": "claude-agent",
      "validation_status": "provisional; dating role-specific accuracy not measured",
      "backends": {
        "openrouter": {
          "model": "openai/gpt-6-astra",
          "fallbacks": [
            "openai/gpt-5.6-sol"
          ],
          "batch_model": "openai/gpt-6-astra:batch",
          "reasoning": {
            "effort": "high"
          },
          "max_tokens": 64000,
          "cache_system_prompt": true
        },
        "anthropic": {
          "model": "claude-opus-5",
          "effort": "high",
          "max_tokens": 64000
        },
        "claude-agent": {
          "model": "claude-opus-5",
          "effort": "high",
          "max_tokens": 64000
        },
        "codex": {
          "model": "gpt-5.6-terra",
          "effort": "high"
        }
      }
    }
  },
  "$comment": [
    "Dating harness configuration. Model, provider, effort, routing and cost choices are provisional and adjustable through evaluation.",
    "Backend-specific connection/runtime policies live in backends; model settings live in roles.<role>.backends.<backend>.",
    "DATING_LLM_CONFIG selects an alternate v2 file for controlled experiments; DATING_LLM_BACKEND overrides per-role selection.",
    "Historical rationale is preserved separately and is not current model/provider validation."
  ],
  "selection_history": "packages/dating/docs/archive/llm-config-2026-09-20.json",
  "single_researcher": {
    "default_profile": "codex-astra",
    "validation_status": "Provisional single-agent profiles; high effort is a quality/cost hypothesis, not a measured optimum.",
    "limits": {
      "searches": 8,
      "acquisitions": 12,
      "tool_calls": 120,
      "model_turns": 64,
      "openrouter_cost_stop_usd": 15
    },
    "profiles": {
      "codex-astra": {
        "backend": "codex",
        "model": "gpt-6-astra",
        "effort": "high"
      },
      "claude-opus": {
        "backend": "claude-agent",
        "model": "claude-opus-5",
        "effort": "high"
      },
      "openrouter-astra": {
        "backend": "openrouter",
        "model": "openai/gpt-6-astra",
        "effort": "high",
        "max_output_tokens": 16000,
        "provider": {
          "require_parameters": true,
          "allow_fallbacks": false,
          "zdr": true,
          "data_collection": "deny"
        }
      },
      "openrouter-opus": {
        "backend": "openrouter",
        "model": "anthropic/claude-opus-5",
        "effort": "high",
        "max_output_tokens": 16000,
        "provider": {
          "require_parameters": true,
          "allow_fallbacks": false,
          "zdr": true,
          "data_collection": "deny"
        }
      }
    }
  }
}
