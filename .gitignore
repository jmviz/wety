/target/
.env
.venv/
.claude/
.github/*
!.github/workflows/
.DS_Store
__pycache__/
*.pyc
*.egg-info/

# data/ is the private research store (`wety-data store`: restic snapshots, merged
# between checkouts with `sync`); git holds only what the app is built from, small
# references code reads, the snapshot pointer, and human-readable records. Research
# outputs (evidence, ledger, runs, packets, receipts) never enter git. Change this list
# deliberately: docs/architecture/provenance.md.
/data/**
!/data/**/
/data/archive/
/data/cache/
/data/runs/
/data/artifacts/*/
!/data/artifacts/wiktionary-export/
!/data/artifacts/iecor/

# What the server and website are built from (deploy.yml SERVER_PATHS).
!/data/registry/inputs.json
!/data/registry/retired-language-codes.json
!/data/artifacts/wiktionary-export/legacy/files/*.json
!/data/artifacts/wiktionary-export/*/files/*.json
!/data/artifacts/iecor/legacy/files/*.csv
!/data/products/dating/language_periods.json

# Small references code reads: build configuration, locks, product pointers, the
# 2026-09 relocation map, curated catalog inputs.
!/data/registry/source-lock.json
!/data/registry/source-recipes.json
!/data/registry/artifacts.json
!/data/registry/embedding-model.json
!/data/registry/migrations/**
!/data/products/*/CURRENT.json
!/data/products/iecor/iecor_matches_receipt.json
!/data/workspaces/catalogs/overrides.json
!/data/workspaces/catalogs/sources/manifest.json

# The research-data snapshot this commit was made with.
!/data/SNAPSHOT.json

# Human-readable research records: briefs and run READMEs.
!/data/workspaces/dating/_research/briefs/*.md
!/data/workspaces/dating/_research/*/README.md

# Lock files anywhere.
*.json.lock
*.jsonl.lock
*.lock.lock
.publish.lock
.source.lock
_pipeline.lock
_registry.lock
